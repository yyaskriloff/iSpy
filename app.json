{
  "expo": {
    "name": "iSpy",
    "slug": "ispy",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ispy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.ispy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "iSpy needs the camera to stream video to a viewer on your Wi‑Fi.",
        "NSMicrophoneUsageDescription": "iSpy needs the microphone to stream audio to a viewer on your Wi‑Fi.",
        "NSLocalNetworkUsageDescription": "iSpy uses the local network so a viewer phone can connect to the camera phone.",
        "NSBonjourServices": ["_ispy._tcp."],
        "UIBackgroundModes": ["audio"]
      },
      "bitcode": false
    },
    "android": {
      "package": "com.ispy.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1220",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow iSpy to access your camera for LAN streaming",
          "microphonePermission": "Allow iSpy to access your microphone for LAN streaming"
        }
      ],
      "./plugins/withIspyAndroid.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "154a1d34-34fb-41c1-9244-95d5459c3515"
      }
    }
  }
}
